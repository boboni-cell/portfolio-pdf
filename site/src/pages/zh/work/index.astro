---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkIndexLayout from '../../../components/WorkIndexLayout.astro';
import { getContent } from '../../../content/i18n';

const t = getContent('zh');
---

<BaseLayout title={`${t.work.title} · ${t.metaTitle}`} langAttr={t.langAttr} description={t.work.title} canonical="https://portfolio.hanyue-room.design/zh/work/" alternateHref="https://portfolio.hanyue-room.design/ko/work/" alternateLang="ko">
  <WorkIndexLayout locale="zh" t={t} />
</BaseLayout>

---
import type { Locale } from '../content/i18n';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath } = Astro.props;
const otherLocale: Locale = locale === 'zh' ? 'ko' : 'zh';

// Build the target URL preserving the current page path
function getTargetPath(currentPath: string | undefined, from: Locale, to: Locale): string {
  if (!currentPath || currentPath === `/${from}/` || currentPath === `/${from}`) {
    return `/${to}/`;
  }
  // Replace the locale prefix: /zh/work/xiaonuan/ -> /ko/work/xiaonuan/
  return currentPath.replace(`/${from}/`, `/${to}/`);
}

const targetHref = getTargetPath(currentPath, locale, otherLocale);
---

<div class="lang-switch">
  {locale === 'zh' ? (
    <>
      <button class="lang-btn active" aria-pressed="true">中文</button>
      <span class="lang-sep" aria-hidden="true">/</span>
      <a class="lang-btn" href={targetHref} aria-pressed="false">한국어</a>
    </>
  ) : (
    <>
      <a class="lang-btn" href={targetHref} aria-pressed="false">中文</a>
      <span class="lang-sep" aria-hidden="true">/</span>
      <button class="lang-btn active" aria-pressed="true">한국어</button>
    </>
  )}
</div>

<script>
  // Also handle the localStorage preference on click
  document.querySelectorAll<HTMLAnchorElement>('.lang-btn[href]').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        localStorage.setItem('preferred-lang', btn.getAttribute('aria-pressed') === 'true' ? '' : (btn.textContent?.trim() === '한국어' ? 'ko' : 'zh'));
      } catch {
        // localStorage unavailable
      }
    });
  });
</script>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: var(--text-sm);
  }

  .lang-btn {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0.2em 0.3em;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease;
    text-decoration: none;
  }

  .lang-btn:hover {
    opacity: 1;
  }

  .lang-btn.active {
    opacity: 1;
    font-weight: 700;
  }

  .lang-sep {
    opacity: 0.4;
  }
</style>

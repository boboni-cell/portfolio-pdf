---
import type { Locale, SiteContent } from '../content/i18n';
import Header from './Header.astro';

interface Props { locale: Locale; t: SiteContent; }
const { locale, t } = Astro.props;
const navItems = [
  { num: '01', href: `/${locale}/work/`, label: t.nav.work, en: 'SELECTED WORK' },
  { num: '02', href: `/${locale}/capability/`, label: t.nav.capability, en: 'CAPABILITY' },
  { num: '03', href: `/${locale}/about/`, label: t.nav.about, en: 'ABOUT' },
  { num: '04', href: `/${locale}/contact/`, label: t.nav.contact, en: 'CONTACT' },
];
---

<Header locale={locale} nav={t.nav} currentPath={`/${locale}/`} />

<main class="hp-root" id="hp-root">
  <div class="hp-bg" aria-hidden="true"></div>

  <div class="hp-grid">

    <!-- Identity block (parallax: light) -->
    <div class="hp-id" id="hp-id">
      <span class="hp-name-cn">{t.hero.name}</span>
      <span class="hp-role sys">{t.hero.role}</span>
    </div>

    <!-- Dual-layer giant title -->
    <div class="hp-giant-wrap" id="hp-giant-wrap">
      <!-- Ghost outline layer (larger amplitude, trailing) -->
      <h1 class="hp-giant hp-giant-ghost" aria-hidden="true">
        <span class="hp-line hp-l1-ghost" id="hp-l1-ghost">ZHANG</span>
        <span class="hp-line hp-l2-ghost" id="hp-l2-ghost">HANYUE</span>
      </h1>
      <!-- Solid fill layer (primary) -->
      <h1 class="hp-giant hp-giant-solid" aria-label="ZHANG HANYUE">
        <span class="hp-line hp-l1-solid" id="hp-l1-solid">ZHANG</span>
        <span class="hp-line hp-l2-solid" id="hp-l2-solid">HANYUE</span>
      </h1>
    </div>

    <p class="hp-tagline" id="hp-tagline">{t.hero.tagline}<br>{t.hero.taglineAccent}</p>

    <nav class="hp-nav" id="hp-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a class="hp-nav-item" href={item.href}>
          <span class="hp-nav-num sys">{item.num}</span>
          <span class="hp-nav-en">{item.en}</span>
          <span class="hp-nav-label">{item.label}</span>
        </a>
      ))}
    </nav>

  </div>
</main>

<style>
  .hp-root {
    min-height: 100vh; min-height: 100svh;
    background: var(--c-hero);
    color: var(--paper);
    display: flex; align-items: center;
    overflow: hidden;
    position: relative;
  }

  .hp-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      repeating-linear-gradient(0deg, transparent, transparent 80px, rgba(244,244,242,0.018) 80px, rgba(244,244,242,0.018) 81px),
      repeating-linear-gradient(90deg, transparent, transparent 80px, rgba(244,244,242,0.018) 80px, rgba(244,244,242,0.018) 81px);
    animation: hp-drift 40s linear infinite;
    pointer-events: none;
  }
  @keyframes hp-drift { to { transform: translate(80px, 80px); } }
  @media (prefers-reduced-motion: reduce) { .hp-bg { animation: none; } }

  .hp-grid {
    width: 100%; position: relative; z-index: 1;
    padding: calc(var(--space-5) + 3rem) var(--pad) var(--space-3);
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    grid-template-rows: auto 1fr auto auto;
    gap: var(--space-3) var(--space-4);
    min-height: 100vh; min-height: 100svh;
    align-content: space-between;
  }

  /* ---- Identity ---- */
  .hp-id { grid-column: 1; grid-row: 1; display: flex; align-items: baseline; gap: var(--space-2); will-change: transform; }
  .hp-name-cn { font-size: var(--text-lg); font-weight: 900; background: var(--paper); color: var(--c-hero-deep); padding: 0.15em 0.5em; }
  .hp-role { color: var(--paper); opacity: 0.8; }

  /* ---- Dual-layer title ---- */
  .hp-giant-wrap {
    grid-column: 1 / -1; grid-row: 2;
    position: relative; display: flex; flex-direction: column; justify-content: center;
    pointer-events: none; user-select: none;
  }

  .hp-giant {
    font-family: var(--font-display); line-height: 0.86;
    text-transform: uppercase; letter-spacing: -0.015em;
    display: flex; flex-direction: column;
  }

  .hp-giant-ghost {
    position: absolute; inset: 0; z-index: 0;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(244,244,242,0.3);
  }

  .hp-giant-solid {
    position: relative; z-index: 1;
    color: var(--paper);
  }

  .hp-line {
    font-size: clamp(5.5rem, 20vw, 22rem);
    white-space: nowrap;
    margin-left: -0.03em;
    will-change: transform;
  }

  .hp-l1-solid, .hp-l1-ghost { align-self: flex-start; }
  .hp-l2-solid, .hp-l2-ghost { align-self: flex-end; margin-right: -0.04em; }

  /* ---- Tagline & count ---- */
  .hp-tagline {
    grid-column: 1; grid-row: 3;
    font-size: var(--text-md); font-weight: 500; line-height: 1.6;
    opacity: 0.85; max-width: 18em; align-self: end;
    will-change: transform;
  }
  /* ---- Navigation ---- */
  .hp-nav {
    grid-column: 1 / -1; grid-row: 4;
    display: flex; gap: 0;
    border-top: 1px solid rgba(244,244,242,0.15);
    margin-top: var(--space-2);
  }

  .hp-nav-item {
    flex: 1;
    display: flex; flex-direction: column;
    padding: 1rem var(--space-2);
    text-decoration: none; color: inherit;
    position: relative;
    border-right: 1px solid rgba(244,244,242,0.1);
    transition: background 0.3s ease;
  }
  .hp-nav-item:last-child { border-right: none; }
  .hp-nav-item:hover { background: rgba(244,244,242,0.06); }
  .hp-nav-item:focus-visible { outline: 2px solid var(--paper); outline-offset: 2px; background: rgba(244,244,242,0.06); }

  .hp-nav-num { font-size: var(--text-xs); opacity: 0.3; margin-bottom: var(--space-1); transition: opacity 0.25s ease; }
  .hp-nav-item:hover .hp-nav-num { opacity: 0.8; }
  .hp-nav-en {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 2vw, 1.3rem);
    letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.2;
    transition: letter-spacing 0.3s ease;
  }
  .hp-nav-item:hover .hp-nav-en { letter-spacing: 0.1em; }
  .hp-nav-label { font-size: var(--text-sm); opacity: 0.45; margin-top: 2px; transition: opacity 0.25s ease; }
  .hp-nav-item:hover .hp-nav-label { opacity: 0.8; }

  @media (max-width: 720px) {
    .hp-grid { grid-template-columns: 1fr; grid-template-rows: auto auto 1fr auto auto; gap: var(--space-3); align-content: start; }
    .hp-id, .hp-giant-wrap, .hp-tagline, .hp-nav { grid-column: 1; }
    .hp-giant-wrap { grid-row: 2; }
    .hp-line { font-size: clamp(3.5rem, 18vw, 6rem); }
    .hp-l2-solid, .hp-l2-ghost { align-self: flex-start; }
    .hp-tagline { grid-row: 3; font-size: var(--text-base); max-width: none; align-self: start; }
    .hp-nav { grid-row: 4; flex-wrap: wrap; }
    .hp-nav-item { flex: 1 1 45%; border-right: none; border-bottom: 1px solid rgba(244,244,242,0.1); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { registerMotion } from '../scripts/motion/motionManager';
  import { initCustomCursor } from '../scripts/motion/customCursor';
  import { initMagnetic } from '../scripts/motion/magnetic';
  import { initPageTransitions } from '../scripts/motion/pageTransitions';
  import { motionDisabled } from '../scripts/motion/motionManager';

  const REDUCED = motionDisabled();

  // ── Elements ──────────────────────────────────────────
  const l1Solid  = document.getElementById('hp-l1-solid')  as HTMLElement;
  const l2Solid  = document.getElementById('hp-l2-solid')  as HTMLElement;
  const l1Ghost  = document.getElementById('hp-l1-ghost')  as HTMLElement;
  const l2Ghost  = document.getElementById('hp-l2-ghost')  as HTMLElement;
  const idEl     = document.getElementById('hp-id')        as HTMLElement;
  const tagEl    = document.getElementById('hp-tagline')   as HTMLElement;
  const navEl    = document.getElementById('hp-nav')       as HTMLElement;

  // ── INITIAL STATE (off-screen) ────────────────────────
  if (!REDUCED) {
    gsap.set([l1Solid, l1Ghost], { xPercent: -115, scaleX: 0.88 });
    gsap.set([l2Solid, l2Ghost], { xPercent:  115, scaleX: 0.88 });
  }

  // ── ENTRANCE ANIMATION ────────────────────────────────
  if (!REDUCED) {
    const tl = gsap.timeline({ defaults: { ease: 'power4.out', duration: 1.3 } });

    tl.to([l1Solid, l1Ghost], { xPercent: 0, scaleX: 1 }, 0)
      .to([l2Solid, l2Ghost], { xPercent: 0, scaleX: 1 }, 0.14);

    // Aux elements fade up after title lands
    const auxEls = gsap.utils.toArray<HTMLElement>([idEl, tagEl, navEl]);
    tl.fromTo(auxEls,
      { y: 40, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.7, stagger: 0.08, ease: 'expo.out' },
      0.65
    );
  } else {
    // Reduced motion: just show everything
    gsap.set([idEl, tagEl, navEl], { opacity: 1, y: 0 });
  }

  // ── MOUSE-DRIVEN LINE SLIDE ───────────────────────────
  if (!REDUCED) {
    // quickTo instances for continuous smooth updates
    const qL1SolidX  = gsap.quickTo(l1Solid,  'x', { duration: 0.55, ease: 'power2.out' });
    const qL1SolidY  = gsap.quickTo(l1Solid,  'y', { duration: 0.55, ease: 'power2.out' });
    const qL1SolidSX = gsap.quickTo(l1Solid,  'scaleX', { duration: 0.45, ease: 'power2.out' });
    const qL1SolidSK = gsap.quickTo(l1Solid,  'skewX', { duration: 0.45, ease: 'power2.out' });

    const qL2SolidX  = gsap.quickTo(l2Solid,  'x', { duration: 0.55, ease: 'power2.out' });
    const qL2SolidY  = gsap.quickTo(l2Solid,  'y', { duration: 0.55, ease: 'power2.out' });
    const qL2SolidSX = gsap.quickTo(l2Solid,  'scaleX', { duration: 0.45, ease: 'power2.out' });
    const qL2SolidSK = gsap.quickTo(l2Solid,  'skewX', { duration: 0.45, ease: 'power2.out' });

    const qL1GhostX   = gsap.quickTo(l1Ghost,  'x', { duration: 0.7, ease: 'power2.out' });
    const qL2GhostX   = gsap.quickTo(l2Ghost,  'x', { duration: 0.7, ease: 'power2.out' });

    // Aux elements (lighter parallax)
    const qIdX    = idEl    ? gsap.quickTo(idEl,    'x', { duration: 0.5, ease: 'power2.out' }) : null;
    const qTagX   = tagEl   ? gsap.quickTo(tagEl,   'x', { duration: 0.5, ease: 'power2.out' }) : null;
    const qNavX   = navEl   ? gsap.quickTo(navEl,   'x', { duration: 0.5, ease: 'power2.out' }) : null;

    // Pointer state
    let px = window.innerWidth / 2;
    let py = window.innerHeight / 2;
    let prevPx = px;
    let onScreen = false;

    // Velocity tracking
    let velX = 0;
    const velHistory: number[] = [];

    const onMove = (e: PointerEvent) => {
      prevPx = px;
      px = e.clientX;
      py = e.clientY;
      onScreen = true;

      velHistory.push(px - prevPx);
      if (velHistory.length > 8) velHistory.shift();
      velX = velHistory.reduce((a, b) => a + b, 0) / velHistory.length;
    };

    const onLeave = () => { onScreen = false; };

    document.addEventListener('pointermove', onMove, { passive: true });
    document.addEventListener('pointerleave', onLeave);

    // Per-frame update
    let raf = 0;
    const update = () => {
      const w = window.innerWidth;
      const h = window.innerHeight;

      // Smooth lerp toward center when pointer is off-screen
      const targetX = onScreen ? px : w / 2;
      const targetY = onScreen ? py : h / 2;

      // Normalized coords (-1..1) with lerp toward target
      const nx = (targetX / w - 0.5) * 2;
      const ny = (targetY / h - 0.5) * 2;

      // ── Solid layer ──────────────────────────────────
      const solidAmp = Math.min(w * 0.09, 130);
      const solidXAmp = solidAmp * nx;
      const solidYAmp = 8 * ny;

      qL1SolidX(solidXAmp);
      qL1SolidY(solidYAmp);

      qL2SolidX(-solidXAmp);
      qL2SolidY(-solidYAmp);

      // ── Ghost layer (larger amplitude, slower) ────────
      const ghostAmp = Math.min(w * 0.14, 180);
      qL1GhostX(ghostAmp * nx);
      qL2GhostX(-ghostAmp * nx);

      // ── Velocity stretch ──────────────────────────────
      const vNorm = Math.max(-1, Math.min(1, velX / 30));
      if (Math.abs(velX) > 2) {
        qL1SolidSX(1 + vNorm * 0.06);
        qL1SolidSK(vNorm * -2.5);
        qL2SolidSX(1 - vNorm * 0.06);
        qL2SolidSK(vNorm * -2.5);
      } else {
        qL1SolidSX(1);
        qL1SolidSK(0);
        qL2SolidSX(1);
        qL2SolidSK(0);
      }

      // ── Aux elements (smaller opposite movement) ─────
      qIdX?.(nx * -8);
      qTagX?.(nx * -12);
      qNavX?.(nx * -6);

      raf = requestAnimationFrame(update);
    };
    raf = requestAnimationFrame(update);

    // ── Magnetic nav + cursor + transitions ────────────
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.hp-nav-item');
    registerMotion('magnetic', {
      init: () => {},
      destroy: initMagnetic({
        links: Array.from(navLinks).map(el => ({ el, radius: 90, maxMove: 16, innerMove: 8 })),
      }),
    });

    registerMotion('cursor', { init: initCustomCursor, destroy: () => {} });

    registerMotion('transitions', {
      init: () => {},
      destroy: initPageTransitions({
        links: document.querySelectorAll<HTMLAnchorElement>('.hp-nav-item, .header-name, .lang-btn'),
        getTransitionText: (link) => {
          const en = link.querySelector('.hp-nav-en');
          return en ? en.textContent || '' : link.textContent?.trim() || '';
        },
      }),
    });

    // ── Cleanup ────────────────────────────────────────
    const cleanup = () => {
      cancelAnimationFrame(raf);
      document.removeEventListener('pointermove', onMove);
      document.removeEventListener('pointerleave', onLeave);
      // Reset transforms
      gsap.set([l1Solid, l2Solid, l1Ghost, l2Ghost], { x: 0, y: 0, scaleX: 1, skewX: 0 });
      gsap.set([idEl, tagEl, navEl], { x: 0 });
    };

    // Astro page-leave hook
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }
</script>

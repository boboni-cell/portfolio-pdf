---
import type { ProjectDetail } from '../content/projects';
import type { Locale, SiteContent } from '../content/i18n';
import Header from './Header.astro';
import CaseMediaStage from './CaseMediaStage.astro';
import FullscreenViewer from './FullscreenViewer.astro';

interface Props { project: ProjectDetail; nav: SiteContent['nav']; locale: Locale; }

const { project, nav, locale } = Astro.props;

const transitionLabels: Record<string, string> = {
  'xiaonuan': 'XIAONUAN',
  'comic-studio': 'COMIC STUDIO',
  'ai-infinite-canvas': 'INFINITE CANVAS',
  'milk-ribbon': 'MILK & RIBBON',
  'commercial-video': 'MOTION',
};
const nextTransitionLabel = transitionLabels[project.nextProject.slug] || 'NEXT';

// Build section nav: id + title for each section that has one
const sectionNav = project.sections.filter(s => s.title).map(s => ({ id: s.id, title: s.title }));

// Helper: build media images array from a section
const mediaSrcsets: Record<string, string> = {
  '/media/ai-canvas-1200.webp': '/media/ai-canvas-800.webp 800w, /media/ai-canvas-1200.webp 1200w, /media/ai-canvas-1254.webp 1254w',
  '/media/canvas2-2426.webp': '/media/canvas2-800.webp 800w, /media/canvas2-1200.webp 1200w, /media/canvas2-2426.webp 2426w',
  '/media/canvas4-1478.webp': '/media/canvas4-800.webp 800w, /media/canvas4-1200.webp 1200w, /media/canvas4-1478.webp 1478w',
  '/media/canvas6-1508.webp': '/media/canvas6-800.webp 800w, /media/canvas6-1200.webp 1200w, /media/canvas6-1508.webp 1508w',
  '/media/canvas7-1480.webp': '/media/canvas7-800.webp 800w, /media/canvas7-1200.webp 1200w, /media/canvas7-1480.webp 1480w',
};

function buildMediaImages(s: typeof project.sections[0]) {
  const imgs: Array<{ src: string; alt: string; caption: string; srcset?: string; sizes: string }> = [];
  const pics = [{ src: s.image, alt: s.imageAlt || '', caption: s.imageCaption || '' }, { src: s.image2, alt: s.image2Alt || '', caption: s.image2Caption || '' }, { src: s.image3, alt: s.image3Alt || '', caption: s.image3Caption || '' }];
  for (const p of pics) {
    if (p.src) imgs.push({
      src: p.src,
      alt: p.alt,
      caption: p.caption,
      srcset: mediaSrcsets[p.src],
      sizes: '(min-width: 1280px) 1120px, (min-width: 721px) calc(100vw - 10rem), calc(100vw - 2rem)',
    });
  }
  return imgs;
}
---

<Header locale={locale} nav={nav} currentPath={`/${locale}/work/${project.slug}/`} />

<main class:list={['cs-root', {
  'cs-phone-project': project.mediaPresentation === 'phone',
  'cs-comic-project': project.slug === 'comic-studio',
  'cs-canvas-project': project.slug === 'ai-infinite-canvas',
  'cs-brand-project': project.slug === 'milk-ribbon',
}]} id="cs-root">

  <!-- Sticky section sidebar -->
  <nav class="cs-sidenav" aria-label="Section navigation">
    <ul>
      {sectionNav.map((sn) => (
        <li><a href={`#${sn.id}`} data-section={sn.id} class="sys">{sn.title}</a></li>
      ))}
    </ul>
  </nav>

  <!-- Top navigation bar -->
  <nav class="cs-topnav">
    <a class="cs-topnav-back" href={`/${locale}/work/`} data-transition-label="WORKS">
      <span aria-hidden="true">←</span> <span class="cs-topnav-label-full">{locale === 'zh' ? '精选作品' : '프로젝트'}</span><span class="cs-topnav-label-mob">{locale === 'zh' ? '作品' : '작품'}</span>
    </a>
    <span class="cs-topnav-current sys">
      <span class="cs-topnav-label-full">{project.num} — {project.name}</span>
      <span class="cs-topnav-label-mob">{project.num}</span>
    </span>
    <a class="cs-topnav-next" href={`/${locale}/work/${project.nextProject.slug}/`} data-transition-label={nextTransitionLabel}>
      <span class="cs-topnav-label-full">{project.nextProject.name} <span aria-hidden="true">→</span></span>
      <span class="cs-topnav-label-mob">{locale === 'zh' ? '下一项目' : '다음'} <span aria-hidden="true">→</span></span>
    </a>
  </nav>

  <!-- Project Hero -->
  <section class="cs-hero" id="top">
    <div class="cs-hero-inner">
      <div class="sys cs-hero-meta">Project {project.num} — {project.meta}</div>
      <h1 class="cs-hero-name" id="cs-hero-name">{project.name}</h1>
      <div class="sys cs-hero-name-en">{project.nameEn}</div>
      <p class="cs-hero-sub">{project.subtitle}</p>
      <ul class="cs-hero-tags">
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      {project.liveDemo && (
        <div class="cs-demo-actions">
          {project.slug === 'ai-infinite-canvas' && (
            <a class="cs-demo-cta" href={`/${locale}/work/${project.slug}/demo/`}>
              <span class="cs-demo-label">
                <span>{locale === 'zh' ? project.liveDemo.labelZh : project.liveDemo.labelKo}</span>
                <span class="cs-demo-arrow" aria-hidden="true">↗</span>
              </span>
              <span class="cs-demo-sub sys">INTERACTIVE PORTFOLIO DEMO</span>
            </a>
          )}
          <a class="cs-demo-cta" href={project.liveDemo.url} target="_blank" rel="noreferrer">
            <span class="cs-demo-label">
              <span>{locale === 'zh' ? (project.liveDemo.productLabelZh || project.liveDemo.labelZh) : (project.liveDemo.productLabelKo || project.liveDemo.labelKo)}</span>
              <span class="cs-demo-arrow" aria-hidden="true">↗</span>
            </span>
            <span class="cs-demo-sub sys">LIVE PRODUCT</span>
          </a>
          {project.liveDemo.inviteCodes && project.liveDemo.inviteCodes.length > 0 && (
            <div class="cs-invite">
              <span class="cs-invite-note sys">{locale === 'zh' ? project.liveDemo.inviteNoteZh : project.liveDemo.inviteNoteKo}</span>
              <div class="cs-invite-codes">
                {project.liveDemo.inviteCodes.map((code) => (
                  <button class="cs-invite-code sys" type="button" data-code={code} aria-label={`${locale === 'zh' ? '复制邀请码' : '초대 코드 복사'}: ${code}`}>
                    {code}<span class="cs-invite-copy-icon" aria-hidden="true">⎘</span>
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- Sections -->
  {project.sections.map((s, si) => {
    const hasCards = s.cards && s.cards.length > 0;
    const hasItems = s.items && s.items.length > 0;
    const hasFlow = s.flow && s.flow.length > 0;
    const isAlt = si % 2 === 1;

    return (
      <section class:list={['cs-section', { 'cs-bg-alt': isAlt }]} id={s.id} data-reveal>

        {/* Layout A: simple title + body */}
        {!hasCards && !hasItems && !hasFlow && (
          <div class:list={['cs-section-inner', 'cs-layout-a', { 'cs-section-inner-media': Boolean(s.mediaMode) }]}>
            <div class="sys cs-s-label">{s.label}</div>
            <h2 class="cs-s-title">{s.title}</h2>
            {s.body && <p class="cs-s-body">{s.body}</p>}
            {s.highlight && (
              <div class="cs-highlight">
                {s.highlightLabel && <span class="sys cs-hl-label">{s.highlightLabel}</span>}
                <p>{s.highlight}</p>
              </div>
            )}
            {s.mediaMode && s.image ? (
              <CaseMediaStage mode={s.mediaMode} images={buildMediaImages(s)} annotations={s.annotations} tabLabels={locale === 'zh' ? s.tabLabelsZh : s.tabLabelsKo} locale={locale} sectionId={s.id} />
            ) : (s.image || s.image2) && (
              <div class:list={['cs-fig-grid', { 'cs-fig-grid-4': s.image4 }]}>
                {s.image && (<figure class="cs-section-figure"><img src={s.image} alt={s.imageAlt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image2 && (<figure class="cs-section-figure"><img src={s.image2} alt={s.image2Alt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image3 && (<figure class="cs-section-figure"><img src={s.image3} alt={s.image3Alt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image4 && (<figure class="cs-section-figure"><img src={s.image4} alt={s.image4Alt || ''} loading="lazy" decoding="async" /></figure>)}
              </div>
            )}
          </div>
        )}

        {/* Layout B: two-column — title left, items right */}
        {hasItems && !hasFlow && !hasCards && (
          <div class:list={['cs-section-inner', 'cs-layout-b', { 'cs-section-inner-media': Boolean(s.mediaMode) }]}>
            <div class="cs-lb-left">
              <div class="sys cs-s-label">{s.label}</div>
              <h2 class="cs-s-title">{s.title}</h2>
              {s.body && <p class="cs-s-body">{s.body}</p>}
            </div>
            <div class="cs-lb-right">
              {s.items!.map((item) => (
                <div class="cs-item">
                  {item.label && <div class="cs-item-label">{item.label}</div>}
                  {item.title && <h3 class="cs-item-title">{item.title}</h3>}
                  <p class="cs-item-body">{item.body}</p>
                  {item.image && (
                    <figure class="cs-item-phone">
                      <img src={item.image} alt={item.imageAlt || ''} loading="lazy" decoding="async" />
                    </figure>
                  )}
                </div>
              ))}
              {s.highlight && (
                <div class="cs-highlight">
                  {s.highlightLabel && <span class="sys cs-hl-label">{s.highlightLabel}</span>}
                  <p>{s.highlight}</p>
                </div>
              )}
            </div>
            {s.mediaMode && s.image ? (
              <CaseMediaStage mode={s.mediaMode} images={buildMediaImages(s)} annotations={s.annotations} tabLabels={locale === 'zh' ? s.tabLabelsZh : s.tabLabelsKo} locale={locale} sectionId={s.id} />
            ) : (s.image || s.image2) && (
              <div class:list={['cs-fig-grid', { 'cs-fig-grid-4': s.image4 }]}>
                {s.image && (<figure class="cs-section-figure"><img src={s.image} alt={s.imageAlt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image2 && (<figure class="cs-section-figure"><img src={s.image2} alt={s.image2Alt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image3 && (<figure class="cs-section-figure"><img src={s.image3} alt={s.image3Alt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image4 && (<figure class="cs-section-figure"><img src={s.image4} alt={s.image4Alt || ''} loading="lazy" decoding="async" /></figure>)}
              </div>
            )}
          </div>
        )}

        {/* Layout C: title + card grid + flow */}
        {hasCards && !hasItems && (
          <div class:list={['cs-section-inner', 'cs-layout-c', { 'cs-section-inner-media': Boolean(s.mediaMode) }]}>
            <div class="sys cs-s-label">{s.label}</div>
            <h2 class="cs-s-title">{s.title}</h2>
            {s.body && <p class="cs-s-body">{s.body}</p>}
            <div class="cs-cards">
              {s.cards!.map((card) => (
                <div class="cs-card">
                  <span class="sys cs-card-num">{card.num}</span>
                  <strong>{card.title}</strong>
                  <p>{card.body}</p>
                </div>
              ))}
            </div>
            {s.flow && (
              <div class="cs-flow">
                {s.flowLabel && <div class="cs-flow-label">{s.flowLabel}</div>}
                <div class="cs-flow-row">
                  {s.flow.map((step, i) => (
                    <span class="cs-flow-step"><span class="cs-flow-n">{i + 1}</span>{step}</span>
                  ))}
                </div>
              </div>
            )}
            {s.highlight && (
              <div class="cs-highlight">
                {s.highlightLabel && <span class="sys cs-hl-label">{s.highlightLabel}</span>}
                <p>{s.highlight}</p>
              </div>
            )}
            {s.mediaMode && s.image ? (
              <CaseMediaStage mode={s.mediaMode} images={buildMediaImages(s)} annotations={s.annotations} tabLabels={locale === 'zh' ? s.tabLabelsZh : s.tabLabelsKo} locale={locale} sectionId={s.id} />
            ) : (s.image || s.image2) && (
              <div class:list={['cs-fig-grid', { 'cs-fig-grid-4': s.image4 }]}>
                {s.image && (<figure class="cs-section-figure"><img src={s.image} alt={s.imageAlt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image2 && (<figure class="cs-section-figure"><img src={s.image2} alt={s.image2Alt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image3 && (<figure class="cs-section-figure"><img src={s.image3} alt={s.image3Alt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image4 && (<figure class="cs-section-figure"><img src={s.image4} alt={s.image4Alt || ''} loading="lazy" decoding="async" /></figure>)}
              </div>
            )}
          </div>
        )}

        {/* Layout D: items + flow + cards (complex) */}
        {hasItems && (hasFlow || hasCards) && (
          <div class:list={['cs-section-inner', 'cs-layout-d', { 'cs-section-inner-media': Boolean(s.mediaMode) }]}>
            <div class="sys cs-s-label">{s.label}</div>
            <h2 class="cs-s-title">{s.title}</h2>
            {s.body && <p class="cs-s-body">{s.body}</p>}
            <div class="cs-items cs-items-wide">
              {s.items!.map((item) => (
                <div class="cs-item">
                  {item.label && <div class="cs-item-label">{item.label}</div>}
                  {item.title && <h3 class="cs-item-title">{item.title}</h3>}
                  <p class="cs-item-body">{item.body}</p>
                  {item.image && (
                    <figure class="cs-item-phone">
                      <img src={item.image} alt={item.imageAlt || ''} loading="lazy" decoding="async" />
                    </figure>
                  )}
                </div>
              ))}
            </div>
            {s.flow && (
              <div class="cs-flow">
                {s.flowLabel && <div class="cs-flow-label">{s.flowLabel}</div>}
                <div class="cs-flow-row">
                  {s.flow.map((step, i) => (
                    <span class="cs-flow-step"><span class="cs-flow-n">{i + 1}</span>{step}</span>
                  ))}
                </div>
              </div>
            )}
            {s.cards && (
              <div class="cs-cards">
                {s.cards.map((card) => (
                  <div class="cs-card">
                    <span class="sys cs-card-num">{card.num}</span>
                    <strong>{card.title}</strong>
                    <p>{card.body}</p>
                  </div>
                ))}
              </div>
            )}
            {s.highlight && (
              <div class="cs-highlight">
                {s.highlightLabel && <span class="sys cs-hl-label">{s.highlightLabel}</span>}
                <p>{s.highlight}</p>
              </div>
            )}
            {s.mediaMode && s.image ? (
              <CaseMediaStage mode={s.mediaMode} images={buildMediaImages(s)} annotations={s.annotations} tabLabels={locale === 'zh' ? s.tabLabelsZh : s.tabLabelsKo} locale={locale} sectionId={s.id} />
            ) : (s.image || s.image2) && (
              <div class:list={['cs-fig-grid', { 'cs-fig-grid-4': s.image4 }]}>
                {s.image && (<figure class="cs-section-figure"><img src={s.image} alt={s.imageAlt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image2 && (<figure class="cs-section-figure"><img src={s.image2} alt={s.image2Alt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image3 && (<figure class="cs-section-figure"><img src={s.image3} alt={s.image3Alt || ''} loading="lazy" decoding="async" /></figure>)}
                {s.image4 && (<figure class="cs-section-figure"><img src={s.image4} alt={s.image4Alt || ''} loading="lazy" decoding="async" /></figure>)}
              </div>
            )}
          </div>
        )}

        {s.video && (
          <div class="cs-video-grid">
            <figure class="cs-video-stage">
              <video src={s.video} poster={s.videoPoster || s.image || undefined} controls playsinline preload="metadata" />
              {s.videoLabel && <figcaption class="sys cs-video-caption">{s.videoLabel}</figcaption>}
            </figure>
            {s.video2 && (
              <figure class="cs-video-stage">
                <video src={s.video2} poster={s.video2Poster || undefined} controls playsinline preload="metadata" />
                {s.video2Label && <figcaption class="sys cs-video-caption">{s.video2Label}</figcaption>}
              </figure>
            )}
          </div>
        )}
      </section>
    );
  })}

  <!-- Next Project -->
  <nav class="cs-next">
    <a href={`/${locale}/work/${project.nextProject.slug}/`} class="cs-next-link" data-transition-label={nextTransitionLabel}>
      <span class="sys cs-next-label">{locale === 'zh' ? '下一个项目' : '다음 프로젝트'}</span>
      <span class="cs-next-name" id="cs-next-name">{project.nextProject.name} →</span>
    </a>
  </nav>

  <FullscreenViewer locale={locale} />
</main>

<style>
  .cs-root {
    background: var(--paper); color: var(--ink);
    position: relative;
  }

  /* ---------- Sticky section nav ---------- */
  .cs-sidenav {
    position: fixed; right: var(--pad); top: 50%; transform: translateY(-50%);
    z-index: 80; display: none;
  }

  @media (min-width: 1540px) {
    .cs-sidenav { display: block; }
  }

  .cs-sidenav ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }

  .cs-sidenav a {
    display: block; font-size: var(--text-xs); opacity: 0.35;
    color: var(--ink); text-decoration: none; padding: 2px 0;
    transition: opacity 0.25s ease; max-width: 180px; text-align: right; line-height: 1.3;
  }

  .cs-sidenav a:hover,
  .cs-sidenav a.active { opacity: 1; }

  /* ---------- Top nav ---------- */
  .cs-topnav {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-2);
    padding: calc(var(--space-5) + 3rem) var(--pad) 0;
    font-size: var(--text-sm);
  }

  .cs-topnav-back, .cs-topnav-next { color: var(--c-hero); text-decoration: none; transition: opacity 0.2s ease; white-space: nowrap; }
  .cs-topnav-back:hover, .cs-topnav-next:hover { opacity: 0.6; }
  .cs-topnav-current { opacity: 0.45; text-align: center; }
  .cs-topnav-label-mob { display: none; }

  /* ---------- Hero ---------- */
  .cs-hero { padding: var(--space-5) var(--pad) var(--space-4); }
  .cs-hero-inner { max-width: 880px; }
  .cs-hero-meta { opacity: 0.45; }
  .cs-hero-name {
    font-family: var(--font-display); font-size: clamp(2.2rem, 8vw, 7rem);
    line-height: 0.95; text-transform: uppercase; margin-top: var(--space-2); color: var(--c-hero);
    white-space: nowrap;
  }
  .cs-hero-name-en { margin-top: var(--space-1); opacity: 0.5; }
  .cs-hero-sub { font-size: var(--text-lg); font-weight: 500; margin-top: var(--space-3); max-width: 28em; line-height: 1.6; color: rgba(20,19,23,0.7); }
  .cs-hero-tags { display: flex; flex-wrap: wrap; gap: 0.4em 0.8em; margin-top: var(--space-3); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.06em; }
  .cs-hero-tags li { border: 1px solid rgba(20,19,23,0.2); padding: 0.3em 0.7em; }

  /* ---- Demo CTA ---- */
  .cs-demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-4);
  }

  .cs-demo-cta {
    display: inline-flex; flex-direction: column; gap: 4px;
    padding: 1rem 1.6rem;
    background: var(--c-hero);
    color: var(--paper);
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .cs-demo-cta:hover {
    background: var(--paper);
    color: var(--c-hero);
    outline: 1.5px solid var(--c-hero);
  }
  .cs-demo-cta:focus-visible {
    outline: 2px solid var(--c-hero); outline-offset: 3px;
    background: var(--paper); color: var(--c-hero);
  }

  .cs-demo-cta-secondary {
    background: transparent;
    color: var(--c-hero);
    outline: 1.5px solid var(--c-hero);
  }

  .cs-demo-cta-secondary:hover,
  .cs-demo-cta-secondary:focus-visible {
    background: var(--c-hero);
    color: var(--paper);
  }

  .cs-demo-label {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.8rem);
    text-transform: uppercase; letter-spacing: 0.03em; line-height: 1;
  }

  .cs-demo-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .cs-demo-cta:hover .cs-demo-arrow {
    transform: translate(4px, -4px);
  }

  .cs-demo-sub {
    font-size: 0.65rem; letter-spacing: 0.14em; opacity: 0.7;
  }

  .cs-invite {
    margin-top: var(--space-3);
    display: flex; flex-direction: column; gap: var(--space-1);
  }

  .cs-invite-note {
    font-size: 0.65rem; opacity: 0.5; letter-spacing: 0.06em;
  }

  .cs-invite-codes {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
  }

  .cs-invite-code {
    display: inline-flex; align-items: center; gap: 0.3em;
    padding: 0.35em 0.7em;
    background: rgba(74,58,255,0.08); border: 1px solid rgba(74,58,255,0.2);
    color: var(--c-hero); cursor: pointer;
    font-size: 0.7rem; letter-spacing: 0.08em;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cs-invite-code:hover { background: var(--c-hero); color: var(--paper); }
  .cs-invite-code:focus-visible { outline: 2px solid var(--c-hero); outline-offset: 2px; }
  .cs-invite-code.copied { background: #00C853; color: #fff; border-color: #00C853; }

  .cs-invite-copy-icon { font-size: 0.8em; opacity: 0.6; }

  @media (prefers-reduced-motion: reduce) {
    .cs-demo-cta { transition: none; }
    .cs-demo-cta:hover .cs-demo-arrow { transform: none; }
  }

  /* ---------- Sections ---------- */
  .cs-section { padding: var(--space-6) var(--pad); scroll-margin-top: 5.5rem; }
  .cs-bg-alt { background: #F7F7F5; }
  .cs-section-inner { max-width: 880px; margin: 0 auto; }
  .cs-section-inner-media { max-width: 1180px; }
  .cs-layout-a.cs-section-inner-media > :not(:global(.cms-root)) {
    width: 100%;
    max-width: 880px;
    margin-right: auto;
    margin-left: auto;
  }

  .cs-s-label { opacity: 0.4; }
  .cs-s-title {
    font-family: var(--font-display); font-size: clamp(1.8rem, 4.5vw, 3.5rem);
    line-height: 1.15; text-transform: uppercase; letter-spacing: -0.01em; margin: var(--space-2) 0;
    white-space: nowrap;
  }

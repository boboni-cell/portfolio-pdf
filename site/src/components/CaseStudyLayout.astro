  import { motionDisabled, registerMotion, addToLoop, startLoop } from '../scripts/motion/motionManager';
  import { initCustomCursor } from '../scripts/motion/customCursor';
  import { initPageTransitions } from '../scripts/motion/pageTransitions';
  import { splitToChars } from '../scripts/motion/kineticText';

  // Invite code copy
  document.querySelectorAll<HTMLButtonElement>('.cs-invite-code').forEach(btn => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') || '';
      try {
        await navigator.clipboard.writeText(code);
        btn.classList.add('copied');
        const orig = btn.childNodes[0]?.textContent || code;
        btn.childNodes[0].textContent = '✓ Copied';
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.childNodes[0].textContent = orig;
        }, 1500);
      } catch {
        // Fallback
        const ta = document.createElement('textarea');
        ta.value = code; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); document.body.removeChild(ta);
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1500);
      }
    });
  });

  const disabled = motionDisabled();
  // Cleanup handled by registerMotion / astro:before-swap

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll reveal
  if (!reduceMotion) {
    const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
      el.style.opacity = '1'; el.style.transform = 'none';
    });
  }

  // Sticky section nav
  if (!reduceMotion) {
    const sections = document.querySelectorAll<HTMLElement>('.cs-section[id]');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section]');
    if (sections.length > 0 && navLinks.length > 0) {
      const navObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((a) => a.classList.remove('active'));
            const link = document.querySelector<HTMLAnchorElement>(`[data-section="${entry.target.id}"]`);
            if (link) link.classList.add('active');
          }
        });
      }, { threshold: 0.3, rootMargin: '-20% 0px -60% 0px' });
      sections.forEach((s) => navObserver.observe(s));
    }
  }

  // Hero title proximity + custom cursor + page transitions
  if (!disabled) {
    const heroName = document.getElementById('cs-hero-name');
    const nextName = document.getElementById('cs-next-name');

    // Split hero name into chars for proximity
    if (heroName) {
      const chars = splitToChars(heroName);
      const charData = chars.map(el => ({ el, cx: 0, cy: 0 }));

      const recalc = () => {
        for (const c of charData) {
          const r = c.el.getBoundingClientRect();
          c.cx = r.left + r.width / 2; c.cy = r.top + r.height / 2;
        }
      };
      requestAnimationFrame(() => { recalc(); window.addEventListener('resize', recalc); });

      let px = -9999, py = -9999;
      document.addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; }, { passive: true });

      // Next project chars
      let nChars: Array<{ el: HTMLSpanElement; cx: number; cy: number }> = [];
      if (nextName) {
        const nc = splitToChars(nextName);
        nChars = nc.map(el => ({ el, cx: 0, cy: 0 }));
        const recalcN = () => {
          for (const c of nChars) {
            const r = c.el.getBoundingClientRect();
            c.cx = r.left + r.width / 2; c.cy = r.top + r.height / 2;
          }
        };
        requestAnimationFrame(() => { recalcN(); window.addEventListener('resize', recalcN); });
      }

      const update = () => {
        for (const c of charData) {
          const dx = px - c.cx, dy = py - c.cy;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 220) {
            const s = (1 - dist / 220), s2 = s * s;
            const angle = Math.atan2(dy, dx);
            c.el.style.transform = `translate(${Math.cos(angle) * 14 * s2}px, ${Math.sin(angle) * 10 * s2}px) rotate(${Math.sin(angle*2) * 4 * s2}deg) scale(${1 + 0.08 * s2})`;
          } else { c.el.style.transform = 'none'; }
        }
        for (const c of nChars) {
          const dx = px - c.cx, dy = py - c.cy;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 180) {
            const s = (1 - dist / 180), s2 = s * s;
            const angle = Math.atan2(dy, dx);
            c.el.style.transform = `translate(${Math.cos(angle) * 6 * s2}px, ${Math.sin(angle) * 5 * s2}px)`;
          } else { c.el.style.transform = 'none'; }
        }
      };
      addToLoop(update);
      startLoop();
    }

    registerMotion('cursor', { init: initCustomCursor, destroy: () => {} });
    registerMotion('transitions', {
      init: () => {},
      destroy: initPageTransitions({
        links: document.querySelectorAll<HTMLAnchorElement>('.cs-topnav-back, .cs-topnav-next, .cs-next-link'),
        getTransitionText: (link) => link.dataset.transitionLabel || 'WORKS',
        overlayColor: '#2A1FCC',
      }),
    });
  }
</script>
